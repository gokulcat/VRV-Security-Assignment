{
  "name": "role-manager",
  "version": "1.0.0",
  "private": true,
  "proxy": "http://localhost:5000",
  "dependencies": {
    "@neon/config": "^1.9.2",
    "@neon/env": "^1.6.3",
    "@neon/functions": "^0.11.0",
    "@neondatabase/auth": "^0.6.0-beta",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.1",
    "jose": "^6.2.13",
    "morgan": "^1.10.0",
    "pg": "^8.13.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.28.0",
    "web-vitals": "^2.1.4"
  },
  "scripts": {
    "start": "node server/index.js",
    "server:dev": "nodemon server/index.js",
    "client": "react-scripts start",
    "dev": "concurrently --kill-others -n API,WEB -c blue,green \"npm:server:dev\" \"npm:client\"",
    "build": "react-scripts build",
    "test": "react-scripts test --watchAll=false",
    "test:server": "node --test server/controllers/authController.test.js server/middleware/auth.test.js server/models/User.test.js",
    "seed:admin": "node server/scripts/createAdmin.js"
  },
  "devDependencies": {
    "@babel/plugin-proposal-private-property-in-object": "^7.21.11",
    "@testing-library/jest-dom": "^5.17.0",
    "@testing-library/react": "^13.4.0",
    "@testing-library/user-event": "^13.5.0",
    "autoprefixer": "^10.4.20",
    "concurrently": "^9.1.0",
    "nodemon": "^3.1.7",
    "postcss": "^8.4.49",
    "react-scripts": "5.0.1",
    "tailwindcss": "^3.4.15"
  },
  "engines": {
    "node": ">=20"
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  }
}
